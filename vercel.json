{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/openai-apps-challenge",
      "destination": "/api/openai-apps-challenge"
    },
    {
      "source": "/privacy",
      "destination": "/api/privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/terms"
    },
    {
      "source": "/support",
      "destination": "/api/support"
    },
    {
      "source": "/(activity|plan|explore|receipts|wealth|import|settings|ask|sign-in|auth)(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 30
    }
  }
}
